<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer. Flat black, matching the near-black edges of the
  ic_launcher_foreground artwork so the mask crop and launcher parallax never expose
  a seam. The foreground carries the whole design (drawable-*dpi PNGs, 108dp canvas
  with the art inset to 80dp); this layer only fills what the mask leaves around it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>