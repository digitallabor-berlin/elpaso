diff --git a/test_runner.cc b/test_runner.cc
index 440687e..99358ef 100644
--- a/test_runner.cc
+++ b/test_runner.cc
@@ -423,6 +423,15 @@ TEST_CASE("TC41_ExtractPasoPayment") {
     RunTest("TC41_ExtractPasoPayment");
 }
 
+// A transaction_data item whose type is not a payment at all (PaSO also defines
+// login/SCA types) still names its credential in credential_ids. It must degrade to
+// an ordinary verification entry: the payment branch would report it with no
+// merchant, no amount and no title, and would suppress the normal entry entirely,
+// so the credential matches and is then never shown in the system picker.
+TEST_CASE("TC42_NonPaymentScaFallsBackToEntry") {
+    RunTest("TC42_NonPaymentScaFallsBackToEntry");
+}
+
 TEST_CASE("TC35_WasmAddEntryToSet") {
     RunTest("TC35_WasmAddEntryToSet");
 }
